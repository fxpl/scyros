        int i = 0;
        while (i < values.Length) { i++; }
        do { total /= 2; } while (total > 100);
        switch (i) { case 0: return 0.0; default: break; }
        string path = @"C:\sqrt";
        string raw = """sqrt""";
        string text = $"{total} sqrt";
        return verbose ? total : -total;
    }